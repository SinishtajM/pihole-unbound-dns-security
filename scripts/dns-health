#!/usr/bin/env bash

# Pi-hole + Unbound DNS health check
#
# Optional configuration file: /etc/default/dns-health
# Every setting can also be supplied as an environment variable.

set -u

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

CONFIG_FILE="${DNS_HEALTH_CONFIG:-/etc/default/dns-health}"
if [[ -r "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

DNS_INTERFACE="${DNS_INTERFACE:-$(ip route show default 2>/dev/null | awk 'NR == 1 {print $5}')}"
DNS_INTERFACE="${DNS_INTERFACE:-eth0}"
PIHOLE_DNS="${PIHOLE_DNS:-127.0.0.1}"
PIHOLE_IPV6="${PIHOLE_IPV6:-}"
UNBOUND_HOST="${UNBOUND_HOST:-127.0.0.1}"
UNBOUND_PORT="${UNBOUND_PORT:-5335}"
NORMAL_TEST_DOMAIN="${NORMAL_TEST_DOMAIN:-pi-hole.net}"
BLOCK_TEST_DOMAIN="${BLOCK_TEST_DOMAIN:-doubleclick.net}"
DNSSEC_VALID_DOMAIN="${DNSSEC_VALID_DOMAIN:-dnssec.works}"
DNSSEC_BOGUS_DOMAIN_1="${DNSSEC_BOGUS_DOMAIN_1:-fail01.dnssec.works}"
DNSSEC_BOGUS_DOMAIN_2="${DNSSEC_BOGUS_DOMAIN_2:-dnssec-failed.org}"
ROOT_SERVER="${ROOT_SERVER:-198.41.0.4}"
ROOT_IDENTITY_EXPECTED="${ROOT_IDENTITY_EXPECTED:-ATLAS}"
PIHOLE_LOG="${PIHOLE_LOG:-/var/log/pihole/pihole.log}"

PASS_COUNT=0
WARN_COUNT=0
FAIL_COUNT=0

pass() {
    PASS_COUNT=$((PASS_COUNT + 1))
    printf '[PASS] %s\n' "$1"
}

warn() {
    WARN_COUNT=$((WARN_COUNT + 1))
    printf '[WARN] %s\n' "$1"
}

fail() {
    FAIL_COUNT=$((FAIL_COUNT + 1))
    printf '[FAIL] %s\n' "$1"
}

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        fail "Required command not found: $1"
        return 1
    fi
}

check_service() {
    local service="$1"

    if systemctl is-active --quiet "$service"; then
        pass "$service is running"
    else
        fail "$service is not running"
    fi
}

check_root_response() {
    local transport="$1"
    local extra_args=()
    local output flags

    if [[ "$transport" == "TCP" ]]; then
        extra_args+=(+tcp)
    fi

    output="$(dig @"$ROOT_SERVER" . NS +norec +time=5 +tries=1 "${extra_args[@]}" 2>/dev/null || true)"
    flags="$(grep -m1 'flags:' <<<"$output" || true)"

    if [[ -z "$flags" ]]; then
        fail "Root-server $transport test returned no DNS flags"
    elif grep -Eq 'flags:.*(^|[[:space:]])aa([;[:space:]]|$)' <<<"$flags" \
        && ! grep -Eq 'flags:.*(^|[[:space:]])ra([;[:space:]]|$)' <<<"$flags"; then
        pass "Root-server $transport test returned an authoritative response without RA"
    else
        fail "Root-server $transport test did not return the expected AA-without-RA flags: $flags"
    fi
}

printf '%s\n' '===================================='
printf '%s\n' ' Pi-hole + Unbound DNS Health Check'
printf '%s\n\n' '===================================='

printf 'Hostname: %s\n' "$(hostname)"
printf 'Interface: %s\n\n' "$DNS_INTERFACE"

for command_name in awk cut dig grep head hostname ip sed ss systemctl tail tr; do
    require_command "$command_name" || true
done

printf '%s\n' 'IP address checks:'
if ip -4 -o address show dev "$DNS_INTERFACE" scope global 2>/dev/null | grep -q .; then
    pass "Global IPv4 address found on $DNS_INTERFACE"
    ip -4 -brief address show dev "$DNS_INTERFACE"
else
    fail "No global IPv4 address found on $DNS_INTERFACE"
fi

if ip -6 -o address show dev "$DNS_INTERFACE" scope global 2>/dev/null | grep -q .; then
    pass "Global IPv6 address found on $DNS_INTERFACE"
    ip -6 -brief address show dev "$DNS_INTERFACE"
else
    fail "No global IPv6 address found on $DNS_INTERFACE"
fi

if [[ -n "$PIHOLE_IPV6" ]]; then
    PIHOLE_IPV6_NO_PREFIX="${PIHOLE_IPV6%%/*}"
    if ip -6 -o address show dev "$DNS_INTERFACE" 2>/dev/null \
        | awk '{print $4}' \
        | cut -d/ -f1 \
        | grep -Fxq "$PIHOLE_IPV6_NO_PREFIX"; then
        pass "Configured stable Pi-hole IPv6 address is present"
    else
        fail "Configured stable Pi-hole IPv6 address is missing: $PIHOLE_IPV6_NO_PREFIX"
    fi
else
    warn "PIHOLE_IPV6 is not set; exact stable-address validation was skipped"
fi
printf '\n'

printf '%s\n' 'Service checks:'
check_service pihole-FTL
check_service unbound
printf '\n'

printf '%s\n' 'Listening-port checks:'
SOCKETS="$(ss -H -lntu 2>/dev/null || true)"
if grep -Eq '[:.]53[[:space:]]' <<<"$SOCKETS"; then
    pass "A DNS listener is present on port 53"
else
    fail "No DNS listener was found on port 53"
fi

UNBOUND_SOCKET="${UNBOUND_HOST}:${UNBOUND_PORT}"
if [[ "$UNBOUND_HOST" == *:* ]]; then
    UNBOUND_SOCKET="[${UNBOUND_HOST}]:${UNBOUND_PORT}"
fi

if awk -v endpoint="$UNBOUND_SOCKET" '$5 == endpoint { found = 1 } END { exit found ? 0 : 1 }' <<<"$SOCKETS"; then
    pass "Unbound is listening on $UNBOUND_SOCKET"
else
    fail "Unbound was not found on $UNBOUND_SOCKET"
fi
printf '\n'

printf '%s\n' 'Pi-hole checks:'
if command -v pihole >/dev/null 2>&1; then
    if pihole status >/dev/null 2>&1; then
        pass "Pi-hole CLI reports an operational status"
    else
        warn "Pi-hole CLI returned a non-zero status"
    fi
else
    warn "Pi-hole CLI was not found; service and DNS checks continue"
fi

PIHOLE_NORMAL_OUTPUT="$(dig @"$PIHOLE_DNS" "$NORMAL_TEST_DOMAIN" A +time=3 +tries=1 2>/dev/null || true)"
if grep -q 'status: NOERROR' <<<"$PIHOLE_NORMAL_OUTPUT" \
    && grep -Eq 'ANSWER: [1-9][0-9]*' <<<"$PIHOLE_NORMAL_OUTPUT"; then
    pass "Pi-hole resolves normal domains with a positive answer"
else
    fail "Pi-hole failed to return a positive answer for $NORMAL_TEST_DOMAIN"
fi

BLOCK_OUTPUT="$(dig @"$PIHOLE_DNS" "$BLOCK_TEST_DOMAIN" A +time=3 +tries=1 2>/dev/null || true)"
BLOCK_STATUS="$(sed -n 's/.*status: \([^,]*\),.*/\1/p' <<<"$BLOCK_OUTPUT" | head -n1)"
BLOCK_ANSWER_COUNT="$(sed -n 's/.*ANSWER: \([0-9][0-9]*\).*/\1/p' <<<"$BLOCK_OUTPUT" | head -n1)"

if [[ "$BLOCK_STATUS" == "NXDOMAIN" ]]; then
    pass "$BLOCK_TEST_DOMAIN was blocked with NXDOMAIN"
elif grep -Eq '[[:space:]]A[[:space:]]+0\.0\.0\.0$' <<<"$BLOCK_OUTPUT"; then
    pass "$BLOCK_TEST_DOMAIN was blocked with a null IPv4 response"
elif [[ "$BLOCK_STATUS" == "NOERROR" && "${BLOCK_ANSWER_COUNT:-1}" == "0" ]]; then
    pass "$BLOCK_TEST_DOMAIN was blocked with an empty answer"
else
    fail "$BLOCK_TEST_DOMAIN did not return a recognized Pi-hole blocking response"
fi
printf '\n'

printf '%s\n' 'Unbound checks:'
UNBOUND_NORMAL_OUTPUT="$(dig @"$UNBOUND_HOST" -p "$UNBOUND_PORT" "$NORMAL_TEST_DOMAIN" A +time=5 +tries=1 2>/dev/null || true)"
if grep -q 'status: NOERROR' <<<"$UNBOUND_NORMAL_OUTPUT" \
    && grep -Eq 'ANSWER: [1-9][0-9]*' <<<"$UNBOUND_NORMAL_OUTPUT"; then
    pass "Unbound resolves normal domains with a positive answer"
else
    fail "Unbound failed to return a positive answer for $NORMAL_TEST_DOMAIN"
fi

DNSSEC_FAIL_1="$(dig @"$UNBOUND_HOST" -p "$UNBOUND_PORT" "$DNSSEC_BOGUS_DOMAIN_1" A +time=5 +tries=1 2>/dev/null || true)"
DNSSEC_FAIL_2="$(dig @"$UNBOUND_HOST" -p "$UNBOUND_PORT" "$DNSSEC_BOGUS_DOMAIN_2" A +time=5 +tries=1 2>/dev/null || true)"

if grep -q 'status: SERVFAIL' <<<"$DNSSEC_FAIL_1" \
    || grep -q 'status: SERVFAIL' <<<"$DNSSEC_FAIL_2"; then
    pass "Unbound rejects a deliberately broken DNSSEC domain"
else
    fail "Broken DNSSEC test did not return SERVFAIL"
fi

DNSSEC_VALID_OUTPUT="$(dig +dnssec @"$UNBOUND_HOST" -p "$UNBOUND_PORT" "$DNSSEC_VALID_DOMAIN" A +time=5 +tries=1 2>/dev/null || true)"
if grep -q 'status: NOERROR' <<<"$DNSSEC_VALID_OUTPUT" \
    && grep -Eq 'flags:.*(^|[[:space:]])ad([;[:space:]]|$)' <<<"$DNSSEC_VALID_OUTPUT" \
    && grep -Eq 'ANSWER: [1-9][0-9]*' <<<"$DNSSEC_VALID_OUTPUT"; then
    pass "Unbound authenticated a valid DNSSEC response with a positive answer"
else
    fail "Valid DNSSEC test did not return NOERROR, the AD flag, and a positive answer"
fi
printf '\n'

printf '%s\n' 'Direct root-server checks:'
check_root_response UDP
check_root_response TCP

ROOT_IDENTITY="$(dig @"$ROOT_SERVER" version.bind TXT CH +norec +short +time=5 +tries=1 2>/dev/null | tr -d '"' | head -n1 || true)"
if [[ "$ROOT_IDENTITY" == "$ROOT_IDENTITY_EXPECTED" ]]; then
    pass "Root-server identity matched the expected value: $ROOT_IDENTITY"
elif [[ -n "$ROOT_IDENTITY" ]]; then
    fail "Root-server identity was '$ROOT_IDENTITY'; expected '$ROOT_IDENTITY_EXPECTED'"
else
    fail "Root-server identity query returned no value; expected '$ROOT_IDENTITY_EXPECTED'"
fi
printf '\n'

printf '%s\n' 'Pi-hole to Unbound forwarding check:'
if [[ -r "$PIHOLE_LOG" ]] && tail -n 500 "$PIHOLE_LOG" 2>/dev/null | grep -q "${UNBOUND_HOST}#${UNBOUND_PORT}"; then
    pass "Pi-hole log shows forwarding to ${UNBOUND_HOST}#${UNBOUND_PORT}"
else
    warn "No recent forwarding entry was found for ${UNBOUND_HOST}#${UNBOUND_PORT}"
fi

printf '\nSummary: %d passed, %d warning(s), %d failed.\n' \
    "$PASS_COUNT" "$WARN_COUNT" "$FAIL_COUNT"

if (( FAIL_COUNT > 0 )); then
    exit 1
fi

exit 0
